{
  "name": "@sc/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev-all.mjs",
    "lint": "eslint . && node --import tsx ../../scripts/check-route-permissions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('dist-test/package.json','{\\\"type\\\":\\\"module\\\"}')\" && vitest run",
    "dev:webhooks": "node --env-file=../../.env --import tsx --watch src/webhooks.ts",
    "dev:realtime": "node --env-file=../../.env --import tsx --watch src/realtime.ts",
    "dev:api": "node --env-file=../../.env --import tsx --watch src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@sc/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@sc/db": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "zod": "^3.25.0",
    "@sc/inbox": "workspace:*",
    "@sc/channels": "workspace:*",
    "socket.io": "^4.8.0",
    "ioredis": "^5.4.0",
    "cookie": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@sc/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@sc/testing": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "socket.io-client": "^4.8.0"
  }
}
