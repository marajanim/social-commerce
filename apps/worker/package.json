    "@sc/inbox": "workspace:*",
    "@sc/channels": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@sc/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@types/nodemailer": "^6.4.0",
    "@sc/testing": "workspace:*",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0"
