{
  "name": "@sc/db",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "node --env-file=../../.env --import tsx src/cli/migrate.ts"
  },
  "devDependencies": {
    "@sc/config": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0",
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "@testcontainers/postgresql": "^11.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "default": "./dist/test-support.js"
    }
  }
}
