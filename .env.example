# Copy to .env (never commit .env). Ports avoid the common defaults so this
# stack can run beside other local projects.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_commerce
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/social_commerce

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9100
S3_CONSOLE_PORT=9101

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

API_PORT=4000
WORKER_PORT=4001
