# Copy to .env (never commit .env). Ports avoid the common defaults so this
# stack can run beside other local projects.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_commerce
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/social_commerce

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PORT=9100
S3_CONSOLE_PORT=9101

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

API_PORT=4000
WORKER_PORT=4001

# Database logins, one per process role (created by `pnpm db:migrate`). Dev-only values.
APP_DB_PASSWORD=app_login_dev
AUTH_DB_PASSWORD=auth_login_dev
APP_DATABASE_URL=postgres://app_login:app_login_dev@localhost:5433/social_commerce
AUTH_DATABASE_URL=postgres://auth_login:auth_login_dev@localhost:5433/social_commerce

# Web app origin (emailed links, CSRF check) and API address used by the web dev server.
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MAIL_FROM=Social Commerce <no-reply@localhost>

# `pnpm db:seed`: your workspace and Owner account. Change these for any real deployment.
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_NAME=Shop Owner
SEED_PASSWORD=ChangeMe-Dev-123
SEED_WORKSPACE_NAME=My Shop
SEED_WORKSPACE_SLUG=my-shop
# true adds one user per role plus a second workspace, for manual cross-tenant testing.
SEED_DEMO=true

# ---- Omnichannel inbox ----
WORKER_DB_PASSWORD=worker_login_dev
OUTBOX_DB_PASSWORD=outbox_login_dev
AUDIT_DB_PASSWORD=audit_login_dev
WORKER_DATABASE_URL=postgres://worker_login:worker_login_dev@localhost:5433/social_commerce
OUTBOX_DATABASE_URL=postgres://outbox_login:outbox_login_dev@localhost:5433/social_commerce
AUDIT_DATABASE_URL=postgres://audit_login:audit_login_dev@localhost:5433/social_commerce

WEBHOOK_PORT=4002
REALTIME_PORT=4003
NEXT_PUBLIC_REALTIME_URL=http://localhost:4003

# Channel tokens are encrypted with this key (32 random bytes, base64). Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored channel tokens unreadable, so back it up outside the database.
CHANNEL_KEY_V1=

# Meta app (developers.facebook.com): the secret verifies webhook signatures, the verify token is
# any string you also paste into the app's webhook settings. PUBLIC_WEBHOOK_URL is where Meta can
# reach the webhook receiver (a tunnel such as cloudflared or ngrok in development).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=dev-verify-token
PUBLIC_WEBHOOK_URL=

# Lets owners inject fake customer messages to try the inbox. Ignored in production.
ENABLE_DEV_SIMULATOR=true
